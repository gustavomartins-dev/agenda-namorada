# Hermes stays on the computer and only this server receives its key.
HERMES_API_BASE_URL=http://127.0.0.1:8642
HERMES_API_SERVER_KEY=
# Change only after applying platform_toolsets.api_server=["no_mcp"].
HERMES_NO_MCP_CONFIRMED=false
HERMES_SESSION_ID=agenda_kuromi_nicolly_v1
HERMES_TIMEOUT_MS=60000

# Keep loopback for this local/USB stage. On Android use adb reverse (README).
SERVER_HOST=127.0.0.1
SERVER_PORT=8787
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
MAX_JSON_BYTES=262144
MAX_AUDIO_BYTES=8388608
MAX_AUDIO_SECONDS=90

# "disabled" is honest and safe until local Whisper + ffprobe are installed.
# For whisper.cpp set the four paths below. No shell is used by the server.
TRANSCRIPTION_PROVIDER=disabled
WHISPER_BIN=/absolute/path/to/whisper-cli
WHISPER_MODEL=/absolute/path/to/ggml-base.bin
FFPROBE_BIN=/absolute/path/to/ffprobe
FFMPEG_BIN=/absolute/path/to/ffmpeg
TRANSCRIPTION_TIMEOUT_MS=120000
